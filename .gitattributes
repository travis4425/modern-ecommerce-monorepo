# Chuẩn hoá xuống dòng: repo luôn lưu LF, kể cả khi làm việc trên Windows.
# Thiếu file này, Windows với core.autocrlf=true sẽ báo "modified" hàng loạt
# ngay sau khi clone, và diff giữa hai máy sẽ đầy thay đổi giả.
* text=auto eol=lf

# File nhị phân: tuyệt đối không đụng vào nội dung
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Ẩn khỏi diff review và khỏi thống kê ngôn ngữ của GitHub
pnpm-lock.yaml -diff linguist-generated

# Script PowerShell phải giữ BOM và CRLF: PowerShell 5.1 đọc file không BOM
# theo Windows-1252, làm hỏng mọi ký tự tiếng Việt và gãy parser.
*.ps1 text eol=crlf working-tree-encoding=UTF-8
