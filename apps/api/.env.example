# ─────────────────────────────────────────────────────────────
# apps/api — copy thành .env trước khi chạy `pnpm dev`
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Phải khớp với docker-compose.yml ở gốc repo
DATABASE_URL=postgresql://ecom:ecom_dev_password@localhost:5432/ecommerce?schema=public

# Origin của frontend được phép gọi API (CORS whitelist, phân tách bằng dấu phẩy)
WEB_ORIGIN=http://localhost:5173

# ── Xác thực ─────────────────────────────────────────────────────────────
# BẮT BUỘC, tối thiểu 32 ký tự. Sinh khoá mới:
#   openssl rand -base64 48
# hoặc trong PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_ACCESS_SECRET=doi-chuoi-nay-thanh-khoa-ngau-nhien-it-nhat-32-ky-tu
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=15

# ── Gửi email ────────────────────────────────────────────────────────────
# Bỏ trống SMTP_HOST thì email được IN RA TERMINAL thay vì gửi đi thật —
# đủ để phát triển mà không cần đăng ký dịch vụ nào.
# Muốn thử gửi thật: đăng ký mailtrap.io (miễn phí), vào Inbox > SMTP Settings,
# copy host/port/user/pass vào đây. Mọi email sẽ nằm lại trong hộp thư Mailtrap,
# không bao giờ bay tới người thật.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=E-Commerce <no-reply@example.com>

# Gốc URL frontend, dùng dựng link trong email
WEB_APP_URL=http://localhost:5173

# ── Tải ảnh sản phẩm ─────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_IMAGES_PER_PRODUCT=8
UPLOAD_DIR=uploads
# Gốc URL của chính API này — ảnh lưu đĩa được phục vụ tại <URL này>/uploads/...
API_PUBLIC_URL=http://localhost:8080

# Bỏ trống cả ba dòng dưới thì ảnh được lưu vào thư mục apps/api/uploads (chế độ dev).
# Muốn dùng thật: đăng ký miễn phí ở cloudinary.com, vào Dashboard copy ba giá trị.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommerce/products
