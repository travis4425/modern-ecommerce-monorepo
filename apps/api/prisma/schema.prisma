// ═══════════════════════════════════════════════════════════════════════════
//  E-Commerce Platform — Prisma schema
//
//  Quy ước:
//   • Model viết PascalCase, bảng thật viết snake_case số nhiều qua @@map
//   • Field camelCase, cột thật snake_case qua @map
//   • Tiền: Decimal(12,2) — không bao giờ dùng Float
//   • Thời gian: Timestamptz(6), lưu UTC
//   • Soft delete: deletedAt trên users, categories, products, orders, reviews
//   • Mọi khoá ngoại đều khai báo onDelete tường minh
// ═══════════════════════════════════════════════════════════════════════════

// Prisma 7 dùng generator "prisma-client" (không còn "prisma-client-js") và
// bắt buộc khai báo output. Client sinh ra được gitignore, tái tạo bằng
// `pnpm db:generate` hoặc tự động qua postinstall.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

// Từ Prisma 7, connection URL KHÔNG còn được khai báo ở đây nữa.
// Nó nằm trong prisma.config.ts cho CLI, và được truyền vào PrismaClient
// lúc chạy thông qua driver adapter (@prisma/adapter-pg).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
//  ENUM
// ─────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  MOCK_GATEWAY
}

enum CouponType {
  PERCENT
  FIXED
}

enum InventoryMovementType {
  PURCHASE_IN
  SALE_OUT
  ORDER_CANCELLED
  MANUAL_ADJUST
}

// ─────────────────────────────────────────────────────────────────────────
//  PHÂN QUYỀN
// ─────────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(32)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// Quyền hạt mịn, mã dạng '<tài nguyên>:<hành động>' — ví dụ 'order:update_status'.
/// Middleware checkPermission đọc bảng này, không chỉ dựa vào tên role.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────
//  NGƯỜI DÙNG & PHIÊN ĐĂNG NHẬP
// ─────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(120)
  phone           String?   @db.VarChar(20)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(500)
  roleId          String    @map("role_id") @db.Uuid
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Xoá user thì RESTRICT với đơn hàng: dữ liệu tài chính không được biến mất.
  role                Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  addresses           Address[]
  cart                Cart?
  orders              Order[]
  reviews             Review[]
  couponRedemptions   CouponRedemption[]
  auditLogs           AuditLog[]
  inventoryMovements  InventoryMovement[]
  idempotencyKeys     IdempotencyKey[]

  @@index([roleId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

/// Một dòng cho mỗi refresh token đã phát. Lưu hash chứ không lưu token thô.
/// familyId nối các token sinh ra từ cùng một lần đăng nhập: nếu một token đã
/// thu hồi bị dùng lại, toàn bộ family bị revoke — đó là cơ chế phát hiện đánh cắp.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  recipientName String    @map("recipient_name") @db.VarChar(120)
  phone         String    @db.VarChar(20)
  province      String    @db.VarChar(100)
  district      String    @db.VarChar(100)
  ward          String    @db.VarChar(100)
  streetAddress String    @map("street_address") @db.VarChar(255)
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────────────
//  CATALOG
// ─────────────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?   @db.Text
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Cây danh mục hai cấp. Restrict để không vô tình xoá cả nhánh con.
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id               String    @id @default(uuid()) @db.Uuid
  categoryId       String    @map("category_id") @db.Uuid
  sku              String    @unique @db.VarChar(64)
  name             String    @db.VarChar(200)
  slug             String    @unique @db.VarChar(220)
  shortDescription String?   @map("short_description") @db.VarChar(500)
  description      String?   @db.Text
  brand            String?   @db.VarChar(80)
  price            Decimal   @db.Decimal(12, 2)
  /// Giá gạch ngang để hiển thị mức giảm. Null nghĩa là không khuyến mãi.
  compareAtPrice   Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  isActive         Boolean   @default(true) @map("is_active")
  isFeatured       Boolean   @default(false) @map("is_featured")
  /// Hai cột dưới là cache có chủ đích: tính lại từ bảng reviews mỗi lần đọc
  /// danh sách sản phẩm sẽ tạo aggregate query trên mọi trang. Cập nhật trong
  /// cùng transaction với thao tác tạo/sửa/xoá review (Phase 9).
  ratingAverage    Decimal   @default(0) @map("rating_average") @db.Decimal(3, 2)
  reviewCount      Int       @default(0) @map("review_count")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  attributes         ProductAttribute[]
  inventory          Inventory?
  cartItems          CartItem[]
  orderItems         OrderItem[]
  reviews            Review[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([isFeatured])
  @@index([price])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(500)
  /// public_id của Cloudinary, cần để xoá ảnh cũ khi thay ảnh (Phase 4).
  publicId  String?  @map("public_id") @db.VarChar(255)
  alt       String?  @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Thông số kỹ thuật dạng key-value (Kết nối: Bluetooth 5.3, Switch: Gateron Brown...).
/// Ngành điện tử có bộ thông số khác nhau theo từng loại sản phẩm nên không
/// nhồi thành cột cố định trên bảng products.
model ProductAttribute {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String @db.VarChar(80)
  value     String @db.VarChar(255)
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@map("product_attributes")
}

// ─────────────────────────────────────────────────────────────────────────
//  TỒN KHO
// ─────────────────────────────────────────────────────────────────────────

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @unique @map("product_id") @db.Uuid
  quantity          Int      @default(0)
  /// Số lượng đã giữ chỗ cho đơn đang xử lý nhưng chưa xuất kho.
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

/// Sổ cái tồn kho: mỗi lần số lượng thay đổi đều để lại một dòng.
/// Nhờ vậy luôn trả lời được "vì sao kho còn từng này" mà không cần đoán.
model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  type          InventoryMovementType
  /// Âm khi xuất kho, dương khi nhập kho.
  quantityChange Int                  @map("quantity_change")
  quantityAfter  Int                  @map("quantity_after")
  reason         String?              @db.VarChar(255)
  orderId        String?              @map("order_id") @db.Uuid
  actorId        String?              @map("actor_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([actorId])
  @@map("inventory_movements")
}

// ─────────────────────────────────────────────────────────────────────────
//  GIỎ HÀNG
// ─────────────────────────────────────────────────────────────────────────

/// Giỏ của khách vãng lai nằm ở localStorage phía trình duyệt.
/// Bảng này chỉ giữ giỏ của người đã đăng nhập, một người một giỏ.
model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────────────────────────────────
//  KHUYẾN MÃI
// ─────────────────────────────────────────────────────────────────────────

model Coupon {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique @db.VarChar(32)
  description     String?    @db.VarChar(255)
  type            CouponType
  /// PERCENT: 10 nghĩa là giảm 10%. FIXED: 50000 nghĩa là giảm 50.000đ.
  value           Decimal    @db.Decimal(12, 2)
  minOrderAmount  Decimal    @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  /// Trần giảm giá cho mã PERCENT. Null nghĩa là không giới hạn.
  maxDiscountAmount Decimal? @map("max_discount_amount") @db.Decimal(12, 2)
  /// Tổng số lượt dùng cho mọi người. Null nghĩa là không giới hạn.
  usageLimit      Int?       @map("usage_limit")
  usedCount       Int        @default(0) @map("used_count")
  perUserLimit    Int        @default(1) @map("per_user_limit")
  startsAt        DateTime   @map("starts_at") @db.Timestamptz(6)
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz(6)
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders      Order[]
  redemptions CouponRedemption[]

  @@index([isActive, startsAt, expiresAt])
  @@map("coupons")
}

/// Một dòng cho mỗi lần mã được dùng thành công. Đây là nguồn sự thật để
/// kiểm perUserLimit — đếm trên bảng orders sẽ sai khi đơn bị huỷ.
model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ─────────────────────────────────────────────────────────────────────────
//  ĐƠN HÀNG
// ─────────────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  /// Mã hiển thị cho khách, dạng ORD-20260902-0001.
  orderNumber String      @unique @map("order_number") @db.VarChar(32)
  userId      String      @map("user_id") @db.Uuid
  status      OrderStatus @default(PENDING)

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingFee    Decimal @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)
  couponId       String? @map("coupon_id") @db.Uuid

  /// Địa chỉ giao hàng được chụp lại tại thời điểm đặt, KHÔNG phải khoá ngoại
  /// tới bảng addresses: khách sửa hoặc xoá địa chỉ sau đó thì đơn cũ vẫn phải
  /// giữ nguyên nơi đã giao.
  recipientName String @map("recipient_name") @db.VarChar(120)
  phone         String @db.VarChar(20)
  province      String @db.VarChar(100)
  district      String @db.VarChar(100)
  ward          String @db.VarChar(100)
  streetAddress String @map("street_address") @db.VarChar(255)
  note          String? @db.VarChar(500)

  cancelReason String?   @map("cancel_reason") @db.VarChar(255)
  placedAt     DateTime  @default(now()) @map("placed_at") @db.Timestamptz(6)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(6)
  shippedAt    DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon             Coupon?             @relation(fields: [couponId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  payment            Payment?
  reviews            Review[]
  couponRedemption   CouponRedemption?
  inventoryMovements InventoryMovement[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([placedAt])
  @@index([couponId])
  @@index([deletedAt])
  @@map("orders")
}

/// Mọi thông tin sản phẩm đều được chụp lại: đơn hàng là chứng từ, không
/// được đổi nội dung khi shop sửa tên hay giá sản phẩm về sau.
model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  productName     String   @map("product_name") @db.VarChar(200)
  productSku      String   @map("product_sku") @db.VarChar(64)
  productImageUrl String?  @map("product_image_url") @db.VarChar(500)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity        Int
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @unique @map("order_id") @db.Uuid
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(12, 2)
  /// Mã giao dịch từ cổng thanh toán. Unique để webhook gửi lại hai lần
  /// không tạo được bản ghi thứ hai.
  transactionRef String?       @unique @map("transaction_ref") @db.VarChar(128)
  gatewayPayload Json?         @map("gateway_payload")
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  failedReason   String?       @map("failed_reason") @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────
//  ĐÁNH GIÁ
// ─────────────────────────────────────────────────────────────────────────

/// Ràng buộc unique(user_id, product_id, order_id) khiến mỗi người chỉ đánh giá
/// một sản phẩm một lần cho mỗi đơn — mua lại lần sau thì được đánh giá tiếp.
/// Điều kiện "đơn đã DELIVERED" do tầng service kiểm (Phase 9).
model Review {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  rating    Int
  title     String?   @db.VarChar(150)
  comment   String?   @db.Text
  isVisible Boolean   @default(true) @map("is_visible")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
  @@index([productId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([orderId])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────
//  VẬN HÀNH
// ─────────────────────────────────────────────────────────────────────────

/// Nhật ký thao tác của staff và admin. actorEmail được chụp lại để log vẫn
/// đọc được sau khi tài khoản bị xoá mềm.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String   @map("actor_email") @db.VarChar(255)
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Chống tạo trùng đơn khi người dùng bấm hai lần hoặc mạng chập chờn.
/// Request thứ hai mang cùng key sẽ được trả lại đúng response đã lưu.
model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique @db.VarChar(128)
  userId         String   @map("user_id") @db.Uuid
  endpoint       String   @db.VarChar(120)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
