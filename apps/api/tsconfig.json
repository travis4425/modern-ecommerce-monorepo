{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ecom/shared": ["../../packages/shared/src/index.ts"],
      "@ecom/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/types/express.d.ts",
    "prisma/**/*.ts",
    "tsup.config.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
