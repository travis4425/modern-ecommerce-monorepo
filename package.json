{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Nền tảng E-Commerce production-ready: React + Vite, Express + TypeScript, PostgreSQL",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @ecom/api dev",
    "dev:web": "pnpm --filter @ecom/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "prepare": "husky",
    "db:migrate": "pnpm --filter @ecom/api db:migrate",
    "db:seed": "pnpm --filter @ecom/api db:seed",
    "db:reset": "pnpm --filter @ecom/api db:reset",
    "db:generate": "pnpm --filter @ecom/api db:generate",
    "db:studio": "pnpm --filter @ecom/api db:studio",
    "auth:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/auth-demo.ps1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,jsx,cjs,mjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
